# Server-only: required for production email delivery
RESEND_API_KEY=replace_with_resend_api_key_in_host_dashboard
CONTACT_TO_EMAIL=hello@2sbusinesssupport.com
CONTACT_FROM_EMAIL=verified-sender@example.com

# Server-only endpoint controls
CONTACT_ALLOWED_ORIGINS=https://2sbusinesssupport.com
CONTACT_MAX_BODY_BYTES=16384
CONTACT_PROVIDER_TIMEOUT_MS=8000
CONTACT_RATE_LIMIT_REQUIRED=true
# CONTACT_RATE_LIMITER is a Cloudflare binding, not a text environment value.
TURNSTILE_REQUIRED=true
TURNSTILE_SECRET_KEY=replace_with_turnstile_secret_in_host_dashboard

# Public build-time value; safe to expose in generated contact-page HTML
TURNSTILE_SITE_KEY=replace_with_turnstile_site_key
